{
  "name": "apigw-tester",
  "version": "1.0.0",
  "private": true,
  "description": "Continuous API gateway tester: built-in Petstore (REST+SOAP), load driver, metrics and dashboard in a single app.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @apigw/shared && npm run build -w @apigw/app && npm run build -w @apigw/ui",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm start -w @apigw/app",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down -v",
    "logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
