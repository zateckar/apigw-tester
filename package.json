{
  "name": "apigw-tester",
  "version": "1.0.0",
  "private": true,
  "description": "Continuous API gateway tester: built-in Petstore (REST+SOAP), load driver, metrics and dashboard in a single app.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "bun run --cwd packages/ui clean 2>/dev/null || true",
    "build": "bun run --cwd packages/ui build",
    "test": "bun test packages/app/src",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm test",
    "start": "bun run packages/app/src/index.ts",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down",
    "compose:reset": "docker compose down -v",
    "logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^26.5.1",
    "eslint": "^9.16.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "bun": ">=1.2.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
