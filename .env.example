# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.

# ---- required ----------------------------------------------------------------
# The container exits with a FATAL at startup if this is unset.
# Every route except /health requires this credential.
APP_BASIC_AUTH=admin:change-me

# ---- optional: host wiring ---------------------------------------------------
# Host port to publish the container on (container always listens on 8080).
PORT=8080
# Image to run. Set to a GHCR tag to skip building locally.
# IMAGE=ghcr.io/<owner>/apigw-tester:latest

# ---- optional: gateway under test --------------------------------------------
# Without these the rig targets its own built-in Petstore, which is a useful
# baseline but measures no gateway. Rest and SOAP are fronted separately on a
# real gateway; the legacy GW_* variables apply to both sides as a fallback.
# GW_REST_BASE_URL=https://gw.example.com
# GW_REST_API_KEY=
# GW_REST_API_KEY_HEADER=X-API-Key
# GW_REST_PATH_PREFIX=
# GW_SOAP_BASE_URL=https://gw.example.com
# GW_SOAP_API_KEY=
# GW_SOAP_API_KEY_HEADER=X-API-Key
# GW_SOAP_PATH_PREFIX=

# Whether generated requests carry THIS rig's own Basic credential
# (APP_BASIC_AUTH, the one guarding the dashboard): auto | always | never.
# "auto" — the default — sends it only to the bundled petstore on this process.
# An external gateway gets the API key above and nothing else, so the admin
# password never reaches a third party's access log. Set "always" only if the
# gateway is configured to accept or pass through the same credential.
# GW_REST_FORWARD_BASIC_AUTH=auto
# GW_SOAP_FORWARD_BASIC_AUTH=auto
# Legacy shorthands (apply to both REST and SOAP when the specific var is unset):
# GW_BASE_URL=https://gw.example.com
# GW_API_KEY=
# GW_API_KEY_HEADER=X-API-Key
# GW_PATH_PREFIX=
# GW_FORWARD_BASIC_AUTH=auto

# ---- optional: what the rig asserts ------------------------------------------
# Policy probes (rate limit, bad key, 413, 504, cache, route allowlist, CORS),
# pass/fail thresholds and bounded run length are configured in the UI drawer
# and persisted in the database, not through environment variables:
#   Configure -> Gateway policies        (enable, interval, required policies)
#   Configure -> Pass/fail thresholds    (SLOs; empty field = not asserted)
#   Configure -> Load profile            (durationMinutes; 0 = run until stopped)
# Same thing over the API: PUT /api/policy, PUT /api/config/slo,
# PUT /api/config/profile. Reports: GET /api/runs/<runId>/report[.md].

# ---- optional: storage -------------------------------------------------------
# Inside the container this must stay on the mounted volume.
# DB_PATH=/app/data/metrics.db
